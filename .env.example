# Postgres connection string.
# Vercel: add Neon / Vercel Postgres from the Storage tab and this is injected.
# Local:  docker run -d --name px-pg -e POSTGRES_PASSWORD=problemx \
#           -e POSTGRES_DB=problemx -p 55432:5432 postgres:17-alpine
DATABASE_URL="postgres://postgres:problemx@localhost:55432/problemx"

# Signs the session cookie. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Optional. When set, teammates can create accounts with this code.
# Leave unset and only the first account can ever be created.
# (Runtime-configurable from the /admin console too.)
INVITE_CODE=""

# Optional. The admin owner account is auto-seeded on deploy with a default
# email (admin@admin.com) and a default password hash. Override either here:
#   ADMIN_EMAIL="you@example.com"
#   ADMIN_PASSWORD_HASH="$2b$10$...."   # bcrypt hash, never the plaintext
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
